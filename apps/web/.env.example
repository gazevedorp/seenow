# Todas as variáveis são opcionais.
# Sem elas, o SEENOW abre em modo demonstração e gera com o provedor mock.
# Copie para apps/web/.env.local — o Vite não lê um .env na raiz do monorepo.

# mock | openai | replicate
# openai e replicate só deixam o mock quando VITE_API_URL aponta para a API (fase 2).
VITE_INPAINTING_PROVIDER=mock

# URL da API NestJS. Vazio na fase 1.
VITE_API_URL=

# Supabase Auth entra na fase 2. Se as duas estiverem preenchidas, a tela de entrada só avisa.
# Nunca coloque a service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
