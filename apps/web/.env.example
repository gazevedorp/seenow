# Copie para apps/web/.env.local — o Vite não lê um .env na raiz do monorepo.
# Segredos NÃO levam prefixo VITE_. O servidor de `pnpm --filter web dev` chama os provedores.
# Sem estas chaves a prévia ainda compõe a textura do catálogo, mas a máscara é o
# recorte geométrico (geometric-trapezoid-v1) e o Flux Fill não roda. A tela mostra isso.
# Não há fallback silencioso para heurística de cor nem para gpt-image.

# Token em https://huggingface.co/settings/tokens (permissão de inferência).
# Com ele, a segmentação padrão é nvidia/segformer-b5-finetuned-ade-640-640
# (classes ADE20K wall=0, floor=3, ceiling=5). Se o B5 falhar, o servidor tenta o B2 512.
HF_TOKEN=

# Opcional. Sem HF_TOKEN, o mesmo SegFormer roda no Replicate.
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Polimento Flux Fill. Com as duas chaves, Fal tem prioridade.
# https://fal.ai/dashboard/keys
FAL_KEY=

# Ignorada neste fluxo. Não segmenta e não gera o material.
OPENAI_API_KEY=

# auto | huggingface | replicate | off
# auto = Hugging Face se houver HF_TOKEN, senão Replicate, senão desligado.
SEGMENTATION_PROVIDER=auto
HF_SEGMENT_MODEL=nvidia/segformer-b5-finetuned-ade-640-640
HF_SEGMENT_FALLBACK_MODEL=nvidia/segformer-b2-finetuned-ade-512-512
REPLICATE_SEGMENT_MODEL=simbrams/segformer-b5-finetuned-ade-640-640

# Só entra se a máscara do SegFormer for implausível (cobertura mínima ou quase a foto toda).
REPLICATE_SAM_MODEL=schananas/grounded_sam

# auto | fal | replicate | off
# auto = Fal se houver FAL_KEY, senão Replicate, senão desligado.
POLISH_PROVIDER=auto
FAL_FLUX_MODEL=fal-ai/flux-pro/v1/fill
REPLICATE_POLISH_MODEL=black-forest-labs/flux-fill-pro

# auto | off. Depth Anything V2 só roda com HF_TOKEN e não bloqueia a máscara.
DEPTH_PROVIDER=auto
HF_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf

# Supabase Auth entra na fase 2. Nunca coloque a service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API Nest da fase 2. O fluxo premium desta entrega usa as rotas /api do Vite, não esta URL.
VITE_API_URL=
