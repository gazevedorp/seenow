# Sem nenhuma variável, a região é estimada pelas cores da foto
# e a geração usa a simulação local (só dentro da máscara).
# Copie para apps/web/.env.local — o Vite não lê um .env na raiz do monorepo.
#
# Segredos NÃO levam prefixo VITE_. O servidor do `pnpm --filter web dev` é quem chama o provedor.

# Token em https://replicate.com/account/api-tokens
# Com ele, auto segmenta piso/parede (ADE20K) e pode gerar com flux-fill-pro.
REPLICATE_API_TOKEN=

# Chave da OpenAI. Usada no inpainting (images/edits) quando não há Replicate.
# A segmentação por contorno só roda se SEGMENTATION_PROVIDER=openai.
OPENAI_API_KEY=

# auto | replicate | openai | heuristic
# auto = Replicate se houver REPLICATE_API_TOKEN; senão, estimativa local.
SEGMENTATION_PROVIDER=auto

# ADE20K devolve as classes floor e wall.
# Segment Anything por texto: schananas/grounded_sam
REPLICATE_SEGMENT_MODEL=simbrams/segformer-b5-finetuned-ade-640-640

# auto | mock | replicate | openai
# auto = Replicate, senão OpenAI, senão simulação local.
INPAINTING_PROVIDER=auto
REPLICATE_INPAINT_MODEL=black-forest-labs/flux-fill-pro
OPENAI_INPAINT_MODEL=gpt-image-1.5
OPENAI_SEGMENT_MODEL=gpt-4.1-mini

# low | medium | high — estimativa de custo, não é cobrança real
OPENAI_IMAGE_QUALITY=low

# Pedido do browser. auto fala com /api/inpaint. mock não chama provedor.
# openai e replicate com VITE_API_URL usam a API Nest (fase 2) em vez das rotas locais.
VITE_INPAINTING_PROVIDER=auto

# URL da API NestJS. Vazio na fase 1.
VITE_API_URL=

# Supabase Auth entra na fase 2. Se as duas estiverem preenchidas, a tela de entrada só avisa.
# Nunca coloque a service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
